{
  "name": "disb-gestao",
  "version": "1.7.63",
  "private": true,
  "scripts": {
    "prepare:web": "node scripts/copy-web.mjs",
    "test:push": "node --test tests/push-dispatch.test.mjs",
    "test:whatsapp": "node --test tests/damage-receipt.test.mjs",
    "test:forms": "node --test tests/forms.test.mjs tests/forms-database.test.mjs",
    "android:add": "npm run prepare:web && npx cap add android && node scripts/prepare-android.mjs",
    "android:sync": "npm run prepare:web && npx cap sync android && node scripts/prepare-android.mjs",
    "android:open": "npx cap open android",
    "android:verify": "node scripts/prepare-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/camera": "8.1.0",
    "@capacitor/core": "latest",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/geolocation": "latest",
    "@capacitor/local-notifications": "latest",
    "@capacitor/push-notifications": "latest",
    "@capacitor/share": "8.0.2",
    "@capgo/background-geolocation": "^8.4.7",
    "@supabase/supabase-js": "^2.117.3",
    "leaflet": "^1.9.4",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "@electric-sql/pglite": "0.5.13",
    "read-excel-file": "^9.3.12"
  }
}
